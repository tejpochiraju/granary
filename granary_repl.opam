# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.0.1"
synopsis: "TUI REPL for granary"
depends: [
  "dune" {>= "3.16"}
  "ocaml" {>= "5.4"}
  "granary"
  "lwt" {>= "5.7"}
  "menhir" {>= "20240715"}
  "lwd" {>= "0.5"}
  "nottui" {>= "0.5"}
  "nottui-lwt" {>= "0.5"}
  "lwt_ppx" {build}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/tejpochiraju/granary.git"
