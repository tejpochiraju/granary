# Jepsen checker container for sqlocaml
#
# *** MINIMAL IMAGE: Clojure-only checker (no OCaml, no lazyfs) ***
# For the full OCaml harness + Java/Clojure + lazyfs image, see
# the root Containerfile.jepsen.
#
# Provides Java 21 + Clojure CLI + Jepsen/Elle checker deps.
#
# Build:   podman build -t sqlocaml-jepsen -f jepsen/Containerfile.jepsen .
# Run:     podman run --rm -v $(pwd):/workspace:z -w /workspace/jepsen/clojure \
#            sqlocaml-jepsen clojure -M -m jepsen.check <history.edn> -w list-append

# `--platform` pin: multi-arch base on a shared rootless podman store (#426). An
# unpinned `FROM` can resolve to a foreign-arch image left in the store by the
# cross-arch job and fail at build/run. The `${TARGETPLATFORM:-linux/amd64}`
# default is safe when no `--platform` flag is passed and honours one when it is.
# `ARG TARGETPLATFORM` is required for buildah to expand it at `FROM` time.
ARG TARGETPLATFORM
FROM --platform=${TARGETPLATFORM:-linux/amd64} docker.io/library/clojure:temurin-21-noble

# Pre-download Clojure deps so they're cached in an image layer
WORKDIR /deps
COPY jepsen/clojure/deps.edn ./
RUN clojure -P && rm -rf /deps

WORKDIR /workspace
