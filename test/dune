; Cross-engine benchmark vs C SQLite — needs the `sqlite3` opam library.
; `(optional)` lets builds where `sqlite3` is absent (e.g. `dune build @install`)
; skip it instead of failing; CI and the bench image install `sqlite3` so it is
; still compiled and type-checked there.

(executable
 (name bench_compare)
 (optional)
 (modules bench_compare)
 (libraries
  granary
  granary.store
  granary.unix
  sqlite3
  alcotest
  lwt.unix
  unix
  mirage-crypto-rng
  mirage-crypto-rng.unix))

